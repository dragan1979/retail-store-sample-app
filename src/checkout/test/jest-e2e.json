{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts"
  ],
  "coverageDirectory": "./coverage",
  "coverageReporters": [
    "text",
    "cobertura",
    "lcov"
  ],
  "testEnvironment": "node",
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": ".",
        "outputName": "junit.xml"
      }
    ]
  ]
}